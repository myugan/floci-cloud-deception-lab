# Copy to .env and fill in before running with --profile alerting.
# .env is gitignored -- these are secrets, never commit real values.

# Discord Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# The honeypot's own public URL -- your droplet's IP or domain, not
# localhost. This is what honeypot-liveness checks on a timer, the
# same public path a real attacker would use.
HONEYPOT_URL=http://your-droplet-ip-or-domain:8265/
